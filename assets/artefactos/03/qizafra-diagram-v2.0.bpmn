    <bpmn:messageFlow id="Flow_0sirxtk" sourceRef="Activity_1t33cs9" targetRef="Activity_0ahhij9" />
    <bpmn:textAnnotation id="TextAnnotation_1ahn1qx">
      <bpmn:text>Cerca de Junio, cuando hay climas húmedos.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_156jalg">
      <bpmn:text>En general, cualquier cambio en los materiales o insumos.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_19iik5h">
      <bpmn:text>Aquí por motivos de brevedad se asume que el molino acepta. Sin embargo, en caso de rechazo se busca otro comprador.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0die74k">
      <bpmn:text>Esto facilita el trabajo manual.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ilial6">
      <bpmn:text>Hay dos tipos: Pagos parciales por tonelada, y una liquidación final al concluir la zafra nacional.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_12uu5jq">
      <bpmn:text>Estos procesos serán guiados con el sistema propuesto</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0xvekct" associationDirection="None" sourceRef="Activity_1ceh3nu" targetRef="TextAnnotation_19iik5h" />
    <bpmn:association id="Association_0jo8v8w" associationDirection="None" sourceRef="Activity_1rlr1ck" targetRef="TextAnnotation_12uu5jq" />
    <bpmn:association id="Association_1ra5cnf" associationDirection="None" sourceRef="TextAnnotation_12uu5jq" targetRef="Activity_1jb0ce5" />
