    <bpmn:participant id="Participant_18b9q7c" name="Proceso de Siembra y Cosecha de Caña" processRef="Process_07s9x4c" />
    <bpmn:participant id="Participant_19k977f" name="Molino" processRef="Process_0u6s4e5" />
    <bpmn:messageFlow id="Flow_0binht4" sourceRef="Activity_0jwrcic" targetRef="Activity_1ceh3nu" />
    <bpmn:messageFlow id="Flow_1h5nfko" sourceRef="Activity_1h8xw2u" targetRef="Event_0dcex64" />
    <bpmn:messageFlow id="Flow_0qshj3s" sourceRef="Activity_1oa1vwj" targetRef="Activity_16wot4v" />
